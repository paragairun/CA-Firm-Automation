[Unit]
Description=CA Firm Automation Suite (Flask + APScheduler)
After=network.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/ca-firm-automation
EnvironmentFile=/home/YOUR_LINUX_USER/ca-firm-automation/.env
# IMPORTANT: run as a single process (python app.py), NOT gunicorn with
# multiple workers. The APScheduler jobs and the Gmail poller thread start
# inside the `if __name__ == "__main__"` block — under multiple worker
# processes each would start its own copy, sending every reminder/reply
# multiple times.
ExecStart=/home/YOUR_LINUX_USER/ca-firm-automation/venv/bin/python3 app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
