# Copy this file to .env and fill in real values. Never commit .env or the
# service account JSON key file.

# ── Firm identity ────────────────────────────────────────────────────────
FIRM_NAME=Your CA Firm Name

# ── Google Workspace service account (domain-wide delegation) ────────────
# See README "Google Workspace setup" for the exact Admin Console steps.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_IMPERSONATE_EMAIL=team@yourfirm.com

# ── Google Sheets (data store) ────────────────────────────────────────────
# The long ID in the sheet's URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=

# ── Google Drive (document storage) ───────────────────────────────────────
# Leave blank to auto-create a "CA Firm Documents" folder. Set to a specific
# folder ID (ideally inside a Shared Drive) to use that instead.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Google Calendar (compliance deadlines) ────────────────────────────────
# "primary" = the impersonated mailbox's own calendar, or a dedicated shared
# calendar's ID for firm-wide visibility.
GOOGLE_CALENDAR_ID=primary

# ── Google Chat (partner alerts) ──────────────────────────────────────────
# Google Chat -> the alerts Space -> Apps & integrations -> Manage webhooks.
GOOGLE_CHAT_WEBHOOK_URL=

# ── Gemini (LLM) ───────────────────────────────────────────────────────────
# Google AI Studio -> Get API key (billed against your paid Gemini tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.4
MEMORY_WINDOW=12

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── Gmail polling cadence ──────────────────────────────────────────────────
GMAIL_POLL_SECONDS=60
GMAIL_PROCESSED_LABEL=CA-Firm-Processed

# ── Flask ────────────────────────────────────────────────────────────────
PORT=8000
FLASK_DEBUG=false

# ── Scheduler timezone ────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata
